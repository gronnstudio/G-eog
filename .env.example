# Equilibrium environment template.
# Real values live in .env.local (git-ignored) and in the deployment's
# environment variables. Never commit real values.
#
# The current release ships a fully static, git-based content layer and
# needs NONE of these to run `npm run dev` / `npm run build`. They are the
# forward-looking configuration for the platform phases described in
# docs/13-roadmap.md.

# Public site origin (used for canonical URLs, sitemap, OG images).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Phase 2: database (docs/06-database-schema.md) ---
DATABASE_URL=

# --- Phase 3: auth (Supabase — docs/08-auth-and-contribution.md) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Phase 4: search & AI (pgvector embeddings — docs/09-search-and-ai.md) ---
ANTHROPIC_API_KEY=
EMBEDDINGS_MODEL=

# --- Media (Cloudflare Images / R2) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGES_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
